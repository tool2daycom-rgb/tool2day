# Public site
NEXT_PUBLIC_SITE_URL=https://tool2day.com

# PostgreSQL (Neon / Vercel Postgres / any Postgres)
# Required to store Contact + Project inquiries
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Admin login (never commit real secrets)
ADMIN_USERNAME=admin
# Generate with: node scripts/hash-admin-password.mjs "your-password"
ADMIN_PASSWORD_HASH=
# Random string, at least 32 characters
SESSION_SECRET=

# Optional email notifications for new inquiries
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="tool2day <noreply@tool2day.com>"
MAIL_TO=support@tool2day.com
