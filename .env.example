# Public site
NEXT_PUBLIC_SITE_URL=https://tool2day.com

# PostgreSQL (Neon / Vercel Postgres / any Postgres)
# Required to store Contact + Project inquiries
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Admin login (never commit real secrets)
ADMIN_USERNAME=admin
# Generate with: node scripts/hash-admin-password.mjs "your-password"
ADMIN_PASSWORD_HASH=
# Random string, at least 32 characters
SESSION_SECRET=

# Zoho Mail SMTP (server-side only — never expose in the browser)
# EU accounts often use smtp.zoho.eu; US/global: smtp.zoho.com
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_USER=support@tool2day.com
# Use a Zoho App Password (not the normal login password)
SMTP_PASS=
MAIL_FROM="Tool2day <support@tool2day.com>"
# One or more addresses, comma-separated (recommended: mailbox + personal inbox)
MAIL_TO=support@tool2day.com
